generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- THE CORE OF MULTI-TENANCY ---

model Company {
  id           String @id @default(uuid())
  name         String
  workspaceUrl String @unique
  industry     String?
  otherIndustry String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  ownerId String? @unique // ID of the user who created the company (optional for initial creation)
  owner   User?   @relation("CompanyOwner", fields: [ownerId], references: [id])
  users   User[] @relation("CompanyUsers") // All users belonging to this company

  // All business data models link back to this Company
  products            Product[]
  productCategories   ProductCategory[]
  brands              Brand[]
  warehouses          Warehouse[]
  customers           Customer[]
  suppliers           Supplier[]
  sales               Sale[]
  purchaseOrders      PurchaseOrder[]
  quotations          Quotation[]
  salesReturns        SalesReturn[]
  expenses            Expense[]
  expenseCategories   ExpenseCategory[]
  stockAdjustments    StockAdjustment[]

  @@map("companies")
}

// --- MODIFIED USER & CONTACT MODELS ---

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(STAFF) // Role *within* the company
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // MODIFIED: User now belongs to a Company
  companyId String
  company   Company @relation("CompanyUsers", fields: [companyId], references: [id])

  // Relations
  ownedCompany     Company?        @relation("CompanyOwner")
  expenses         Expense[]
  purchaseOrders   PurchaseOrder[]
  quotations       Quotation[]
  sales            Sale[]
  salesReturns     SalesReturn[]
  stockAdjustments StockAdjustment[]

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  quotations Quotation[]
  sales      Sale[]

  @@unique([companyId, email]) // Email unique per company
  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, email]) // Email unique per company
  @@map("suppliers")
}


// --- MODIFIED PRODUCT & INVENTORY MODELS ---

model Product {
  id           String        @id @default(uuid())
  name         String
  sku          String        // SKU should be unique *per company*
  description  String?
  salePrice    Decimal       @db.Decimal(10, 2)
  costPrice    Decimal       @db.Decimal(10, 2)
  reorderLevel Int           @default(0)
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  categoryId           String
  category             ProductCategory       @relation(fields: [categoryId], references: [id])
  brandId              String?
  brand                Brand?                @relation(fields: [brandId], references: [id])
  inventory            Inventory[]
  purchaseOrderItems   PurchaseOrderItem[]
  quotationItems       QuotationItem[]
  saleItems            SaleItem[]
  salesReturnItems     SalesReturnItem[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@unique([companyId, sku]) // Ensures SKU is unique only within a company
  @@map("products")
}

model ProductCategory {
  id   String @id @default(uuid())
  name String

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  products Product[]

  @@unique([companyId, name]) // Category names unique per company
  @@map("product_categories")
}

model Brand {
  id   String @id @default(uuid())
  name String

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  products Product[]

  @@unique([companyId, name]) // Brand names unique per company
  @@map("brands")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  inventory            Inventory[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@map("warehouses")
}

model Inventory {
  productId   String
  warehouseId String
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, warehouseId])
  @@map("inventory")
}

model StockAdjustment {
  id              String   @id @default(uuid())
  referenceNumber String
  adjustmentDate  DateTime @default(now())
  notes           String?
  totalItems      Int      @default(0)
  netChange       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  userId String
  user   User                 @relation(fields: [userId], references: [id])
  items  StockAdjustmentItem[]

  @@unique([companyId, referenceNumber]) // Reference number unique per company
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String          @id @default(uuid())
  previousQuantity  Int
  newQuantity       Int
  difference        Int
  stockAdjustmentId String
  productId         String
  warehouseId       String
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])

  @@map("stock_adjustment_items")
}


// --- MODIFIED TRANSACTION & EXPENSE MODELS ---

model Expense {
  id          String    @id @default(uuid())
  reference   String
  amount      Decimal   @db.Decimal(10, 2)
  expenseDate DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  description String?   // Renamed from 'notes'
  vendor      String    // New field for the vendor name
  status      ExpenseStatus   @default(PENDING) // New status field
  paymentMethod PaymentMethod?  // New field for payment method

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Foreign Keys
  categoryId String
  userId     String

  // Relations
  category    ExpenseCategory     @relation(fields: [categoryId], references: [id])
  user        User                @relation(fields: [userId], references: [id])
  attachments ExpenseAttachment[] // Relation to new attachments model

  @@map("expenses")
}

model ExpenseAttachment {
  id        String   @id @default(uuid())
  url       String 
  fileName  String
  fileType  String
  createdAt DateTime @default(now())

  // Relation to Expense
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id])

  @@map("expense_attachments")
}

model ExpenseCategory {
  id   String @id @default(uuid())
  name String

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Relations
  expenses Expense[]

  @@unique([companyId, name]) // Category names unique per company
  @@map("expense_categories")
}

// --- OTHER TRANSACTION MODELS ---

model Sale {
  id            String         @id @default(uuid())
  invoiceNumber String
  subtotal      Decimal        @db.Decimal(10, 2)
  tax           Decimal        @db.Decimal(10, 2) @default(0)
  discount      Decimal        @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal        @db.Decimal(10, 2)
  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  saleDate      DateTime       @default(now())
  dueDate       DateTime
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customerEmail String?

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Foreign Keys
  customerId String
  userId     String

  // Relations
  items    SaleItem[]
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([companyId, invoiceNumber]) // Invoice number unique per company
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  saleId    String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  referenceNumber String
  totalAmount     Decimal             @db.Decimal(10, 2)
  status          OrderStatus         @default(PENDING)
  orderDate       DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Foreign Keys
  supplierId String
  userId     String

  // Relations
  items    PurchaseOrderItem[]
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  user     User                @relation(fields: [userId], references: [id])

  @@unique([companyId, referenceNumber]) // Reference number unique per company
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  purchaseOrderId String
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model Quotation {
  id              String          @id @default(uuid())
  referenceNumber String
  totalAmount     Decimal         @db.Decimal(10, 2)
  status          OrderStatus     @default(PENDING)
  quoteDate       DateTime        @default(now())
  expiryDate      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Foreign Keys
  customerId String
  userId     String

  // Relations
  items    QuotationItem[]
  customer Customer        @relation(fields: [customerId], references: [id])
  user     User            @relation(fields: [userId], references: [id])

  @@unique([companyId, referenceNumber]) // Reference number unique per company
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  quotationId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model SalesReturn {
  id              String            @id @default(uuid())
  referenceNumber String
  totalAmount     Decimal           @db.Decimal(10, 2)
  reason          String?
  returnDate      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // NEW: Link to Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Foreign Keys
  userId String

  // Relations
  items SalesReturnItem[]
  user  User              @relation(fields: [userId], references: [id])

  @@unique([companyId, referenceNumber]) // Reference number unique per company
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(uuid())
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  salesReturnId String
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@map("sales_return_items")
}

// --- ENUMS ---

enum UserRole {
  OWNER   // NEW: Add OWNER role for the company creator
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

// NEW: Enum for Expense Status
enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// NEW: Enum for Payment Methods
enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  CHECK
}