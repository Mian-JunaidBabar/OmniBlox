# Database Configuration
# Copy this file to .env and update with your actual database credentials

# Primary database connection URL
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/omniblox?schema=public"

# Pooled database connection URL (optional, for production)
# Uses connection pooling for better performance
# DATABASE_URL_POOLED="postgresql://user:password@localhost:5432/omniblox?schema=public&connection_limit=10"

# Server Configuration
PORT=5000

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (Next.js frontend URL)
CORS_ORIGIN="http://localhost:3000"
